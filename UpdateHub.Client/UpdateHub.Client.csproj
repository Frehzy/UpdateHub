<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Проект существует только затем, чтобы клиент на bash был виден в обозревателе
    решения. Кода C# в нём нет и быть не должно: сам клиент — это сценарии
    оболочки в этом каталоге, они устанавливаются на машины Ubuntu как есть.

    Ссылаться на этот проект неоткуда не нужно, и подключать его к серверу нельзя:
    сборка получится пустой, а смысла в связи никакого.

    Проверяет клиент не сборка C#, а отдельная задача в .github/workflows: разбор
    синтаксиса, shellcheck и 97 проверок из tests/run-tests.sh, плюс сквозная
    проверка против настоящего сервера в контейнерах (tests/e2e.sh).

    Прежде вместо проекта в решении был перечислен список файлов. Список пришлось
    бы править руками при каждом новом сценарии, и он молча отстал бы; проект
    показывает каталог целиком.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Пакет из пустой сборки собирать незачем. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
