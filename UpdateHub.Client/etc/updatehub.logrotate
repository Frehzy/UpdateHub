# Ротация журнала UpdateHub. Устанавливается в /etc/logrotate.d/updatehub.
#
# Клиент дописывает в журнал при каждом запуске, а запусков — по одному в сутки
# годами. Без ротации файл растёт без предела: на машине с двумя гигабайтами
# памяти и небольшим диском это однажды кончится нехваткой места, причём
# в самый неподходящий момент — на скачивании шестигигабайтного образа.
#
# Путь указан по умолчанию, как в updatehub.conf.example. Если вы задали
# в настройках другой LOG_FILE, поправьте и здесь.
#
# Права 0640 и владелец root: служба работает под root (см. systemd/updatehub.service),
# а журнал содержит имена файлов и адрес сервера — читать его всем незачем.
/var/log/updatehub.log {
    weekly
    rotate 8
    size 5M
    missingok
    notifempty
    compress
    delaycompress

    # create, а не copytruncate: клиент открывает журнал заново на каждой строке
    # и удерживаемого описателя не имеет, поэтому обычная замена файла безопасна
    # и не оставляет промежутка, в который запись могла бы потеряться.
    create 0640 root root
}
