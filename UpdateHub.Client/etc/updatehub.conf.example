# Настройки UpdateHub. Скопируйте в /etc/updatehub/updatehub.conf и заполните.
#
# Файл подключается оболочкой, то есть это обычный сценарий: значения
# с пробелами берите в кавычки, знак # начинает комментарий.
#
# Права на файл — 600: в нём может лежать пароль.

# Адрес сервера обновлений. Обязательно.
#
# Указывайте IP-адрес, а не имя: разрешать имена в закрытом контуре некому,
# и первая же установка упёрлась бы в это. Порт — тот, что открыт у сервера
# (в Docker наружу выводится 8080).
SERVER_URL="http://192.168.1.10:8080"

# Папка, которую обновляет этот компьютер.
DATA_DIR="/home/data"

# Временный каталог. Файлы складываются сюда целиком и лишь потом переносятся
# в рабочую папку: оборванное обновление не должно оставить её наполовину
# новой. На время загрузки место расходуется вдвойне.
#
# Не должен находиться внутри DATA_DIR: после переноса он очищается целиком.
TEMP_DIR="/var/tmp/updatehub"

# Служебные данные: токены, отметка о последнем обновлении, файл замка.
STATE_DIR="/var/lib/updatehub"

# Постоянный идентификатор компьютера. Создаётся сам при первом запуске.
# Не удаляйте: по нему привязаны выданные права и вся история обращений.
CLIENT_ID_FILE="/etc/updatehub/client-id"

# Журнал работы. Пусто — писать только на экран.
LOG_FILE="/var/log/updatehub.log"

# Учётные данные.
#
# Если оставить пустыми, скрипт спросит их при запуске. Для обновления
# по расписанию это не подходит: спрашивать некого, и запуск завершится
# ошибкой настройки. Тогда заполните оба поля и закройте файл правами 600.
USERNAME=""
PASSWORD=""

# Запас свободного места сверх объёма загрузки, в мегабайтах.
FREE_SPACE_MARGIN_MB="512"

# Сколько раз повторять оборвавшуюся загрузку файла.
# Отдача шести гигабайт по каналу 2 Мбит/с идёт около семи часов, и обрыв
# на такой дистанции — обычное дело.
DOWNLOAD_RETRIES="10"

# Пауза между повторами, в секундах.
DOWNLOAD_RETRY_DELAY="30"

# Ограничение скорости загрузки в формате curl, например "512k".
# Пусто — без ограничения. Пригодится, если канал делят с другими задачами.
DOWNLOAD_RATE_LIMIT=""

# Время ожидания ответа на служебные запросы, в секундах.
# К загрузке файлов не относится: она идёт часами.
REQUEST_TIMEOUT="60"
