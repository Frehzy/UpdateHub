[Unit]
Description=Ежедневная проверка обновлений UpdateHub

[Timer]
OnCalendar=daily

# Случайная задержка до часа: без неё все компьютеры пойдут за обновлениями
# в одну и ту же секунду и разделят между собой канал 2 Мбит/с.
RandomizedDelaySec=1h

# Если машина была выключена в назначенное время, проверка выполнится
# при следующем включении, а не пропустится до завтра.
Persistent=true

[Install]
WantedBy=timers.target
