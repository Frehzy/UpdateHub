# Выбор способа запуска тестов.
#
# xunit.v3 работает поверх Microsoft.Testing.Platform, а `dotnet test` на .NET 10
# по умолчанию идёт прежним путём — через VSTest, который эта платформа больше
# не поддерживает. Сборка падала с сообщением «Testing with VSTest target is no
# longer supported by Microsoft.Testing.Platform on .NET 10 SDK and later».
#
# В Visual Studio это не проявляется: она запускает тесты своим средством,
# минуя `dotnet test`. Поэтому тесты проходили на машине разработчика и падали
# при сборке по коммитам.
#
# Настройка ниже — заявленный способ переключения, но на SDK 10.0.400 она
# не срабатывает: `dotnet test` всё равно уходит в VSTest. Проверено сборкой
# по коммитам. Поэтому она на этот файл и не опирается — тестовые проекты
# запускаются там напрямую, как обычные приложения. Файл оставлен: способ
# описан в документации, и на следующих выпусках SDK должен заработать.

[dotnet.test:runner]
name = "Microsoft.Testing.Platform"
