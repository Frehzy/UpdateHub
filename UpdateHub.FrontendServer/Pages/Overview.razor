@page "/"
@inject ApiClient Api

@*
    Обзор: состояние каталога раздачи и сводка обращений. Первое, что нужно
    администратору, — понять, разложены ли файлы и доходят ли до них компьютеры.
*@

<h1>Обзор</h1>

@if (_error is not null)
{
    <div class="soobshchenie oshibka">@_error</div>
}

@if (_message is not null)
{
    <div class="soobshchenie udacha">@_message</div>
}

<div class="karta">
    <h2>Каталог раздачи</h2>

    @if (_manifest is null)
    {
        <p class="tusklyy">Загрузка…</p>
    }
    else
    {
        <table>
            <tbody>
                <tr>
                    <th>Файлов в манифесте</th>
                    <td>@_manifest.EntryCount</td>
                </tr>
                <tr>
                    <th>Общий объём</th>
                    <td>@FormatSize(_manifest.TotalSizeBytes)</td>
                </tr>
                <tr>
                    <th>Поколение</th>
                    <td>@_manifest.Generation</td>
                </tr>
                <tr>
                    <th>Последний обход</th>
                    <td>@FormatMoment(_manifest.LastScanCompletedAt)</td>
                </tr>
                <tr>
                    <th>Обход идёт сейчас</th>
                    <td>@(_manifest.IsScanning ? "да" : "нет")</td>
                </tr>
            </tbody>
        </table>

        @if (_manifest.RejectedPaths.Count > 0)
        {
            <div class="soobshchenie vnimanie">
                <strong>Отклонённые пути (@_manifest.RejectedPaths.Count).</strong>
                Эти файлы компьютерам не выдаются: имя не подходит для передачи
                или совпадает с другим без учёта регистра.
                <ul>
                    @foreach (var path in _manifest.RejectedPaths)
                    {
                        <li>@path</li>
                    }
                </ul>
            </div>
        }

        <button @onclick="RescanAsync" disabled="@_busy">
            @(_busy ? "Обход выполняется…" : "Обойти каталог сейчас")
        </button>
        <span class="tusklyy">
            Обход идёт и сам, раз в минуту. Кнопка нужна, чтобы не ждать после
            подкладывания файлов.
        </span>
    }
</div>

<div class="karta">
    <h2>Обращения за последние 30 суток</h2>

    @if (_stats is null)
    {
        <p class="tusklyy">Загрузка…</p>
    }
    else
    {
        <table>
            <tbody>
                <tr>
                    <th>Всего обращений</th>
                    <td>@_stats.TotalRequests</td>
                </tr>
                <tr>
                    <th>Разных компьютеров</th>
                    <td>@_stats.UniqueClients</td>
                </tr>
                <tr>
                    <th>Выдано данных</th>
                    <td>@FormatSize(_stats.TotalDownloadedBytes)</td>
                </tr>
            </tbody>
        </table>

        @if (_stats.RequestsByDay.Count > 0)
        {
            <div class="tablica-obolochka">
                <table>
                    <thead>
                        <tr>
                            <th>Дата</th>
                            <th>Обращений</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in _stats.RequestsByDay)
                        {
                            <tr>
                                <td>@day.Date.ToString("dd.MM.yyyy")</td>
                                <td>@day.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>


<div class="karta">
    <h2>Давно не выходили на связь</h2>

    @if (_stale is null)
    {
        <p class="tusklyy">Загрузка…</p>
    }
    else if (_stale.Total == 0)
    {
        <p class="tusklyy">Все компьютеры выходили на связь за последние @_stale.ThresholdDays сут.</p>
    }
    else
    {
        <p>
            Не обращались дольше @_stale.ThresholdDays сут: <strong>@_stale.Total</strong>.
            Причины бывают разные — машину выключили, скрипт не установлен, права отозваны.
        </p>
        <div class="tablica-obolochka">
            <table>
                <thead>
                    <tr>
                        <th>Идентификатор</th>
                        <th>Имя машины</th>
                        <th>Группа</th>
                        <th>Последнее обращение</th>
                        <th>Состояние</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in _stale.Clients)
                    {
                        <tr>
                            <td>@client.ClientId</td>
                            <td>@(client.Name ?? "—")</td>
                            <td>@(client.GroupName ?? "—")</td>
                            <td>
                                @if (client.LastRequestAt is null)
                                {
                                    <span class="metka zablokirovan">ни разу</span>
                                }
                                else
                                {
                                    @($"{FormatMoment(client.LastRequestAt)} ({client.DaysSinceLastRequest} сут назад)")
                                }
                            </td>
                            <td>
                                @if (client.IsBlocked)
                                {
                                    <span class="metka zablokirovan">заблокирован</span>
                                }
                                else
                                {
                                    <span class="metka">работает</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="karta">
    <h2>Резервная копия базы</h2>
    <p class="tusklyy">
        Копии снимаются по расписанию. Кнопка нужна перед тем, как что-то менять
        руками: в такой момент ждать до ночи неразумно.
    </p>

    @if (_maintenance is not null)
    {
        <table>
            <tbody>
                <tr>
                    <th>Последняя удачная копия</th>
                    <td>
                        @if (_maintenance.LastSuccessAt is null)
                        {
                            <span class="trevoga">с момента запуска ни одной</span>
                        }
                        else
                        {
                            @($"{FormatMoment(_maintenance.LastSuccessAt)}, {FormatSize(_maintenance.LastSuccessSizeBytes)}")
                        }
                    </td>
                </tr>
                @if (_maintenance.LastAttemptAt is not null && !_maintenance.LastAttemptSucceeded)
                {
                    <tr>
                        <th>Последняя попытка</th>
                        <td class="trevoga">
                            @($"{FormatMoment(_maintenance.LastAttemptAt)} — не удалась: {_maintenance.LastAttemptError}")
                        </td>
                    </tr>
                }
                <tr>
                    <th>Копий в каталоге</th>
                    <td>@_maintenance.BackupFilesOnDisk</td>
                </tr>
                <tr>
                    <th>Расписание</th>
                    <td>
                        @(_maintenance.IntervalHours > 0
                            ? $"каждые {_maintenance.IntervalHours} ч, хранить {_maintenance.KeepCount}"
                            : "копирование отключено настройкой")
                    </td>
                </tr>
                <tr>
                    <th>Каталог копий</th>
                    <td>@_maintenance.BackupPath</td>
                </tr>
                <tr>
                    <th>Свободно на дисках</th>
                    <td>
                        @($"копии — {FormatSpace(_maintenance.BackupFreeBytes, _maintenance.BackupTotalBytes)}; " +
                          $"файлы — {FormatSpace(_maintenance.FilesFreeBytes, _maintenance.FilesTotalBytes)}")
                    </td>
                </tr>
            </tbody>
        </table>
    }

    <button @onclick="CreateBackupAsync" disabled="@_busy">
        @(_busy ? "Снятие копии…" : "Снять копию сейчас")
    </button>
</div>

@code {
    private ManifestStatusResponseDto? _manifest;
    private StaleClientListResponseDto? _stale;
    private StatsResponseDto? _stats;
    private MaintenanceStatusDto? _maintenance;
    private string? _error;
    private string? _message;
    private bool _busy;

    /// <summary>Загружает состояние манифеста и статистику.</summary>
    /// <returns>Задача завершения.</returns>
    protected override Task OnInitializedAsync() => LoadAsync();

    /// <summary>Читает данные с сервера.</summary>
    /// <returns>Задача завершения.</returns>
    private async Task LoadAsync()
    {
        _error = null;

        var manifest = await Api.GetAsync<ManifestStatusResponseDto>("api/v1/admin/manifest/status");
        if (manifest.IsSuccess)
        {
            _manifest = manifest.Value;
        }
        else
        {
            _error = manifest.Error;
        }

        var stats = await Api.GetAsync<StatsResponseDto>("api/v1/admin/stats");
        if (stats.IsSuccess)
        {
            _stats = stats.Value;
        }
        else
        {
            _error ??= stats.Error;
        }

        var stale = await Api.GetAsync<StaleClientListResponseDto>("api/v1/admin/clients/stale");
        if (stale.IsSuccess)
        {
            _stale = stale.Value;
        }
        else
        {
            _error ??= stale.Error;
        }

        var maintenance = await Api.GetAsync<MaintenanceStatusDto>("api/v1/admin/maintenance");
        if (maintenance.IsSuccess)
        {
            _maintenance = maintenance.Value;
        }
        else
        {
            _error ??= maintenance.Error;
        }
    }

    /// <summary>
    /// Запускает внеочередной обход каталога.
    /// </summary>
    /// <returns>Задача завершения.</returns>
    /// <remarks>
    /// Обход шестигигабайтного образа занимает заметное время, поэтому кнопка
    /// блокируется до ответа: иначе администратор нажмёт её второй раз
    /// и получит отказ «обход уже выполняется».
    /// </remarks>
    private async Task RescanAsync()
    {
        _busy = true;
        _error = null;
        _message = null;

        var result = await Api.PostAsync<RescanResultDto>("api/v1/admin/manifest/rescan", body: null);

        if (result.IsSuccess && result.Value is not null)
        {
            _message = $"Обход завершён: файлов {result.Value.TotalFiles}, " +
                       $"пересчитано сумм {result.Value.HashedFiles}, изменений {result.Value.Changes}.";
            await LoadAsync();
        }
        else
        {
            _error = result.Error;
        }

        _busy = false;
    }

    /// <summary>
    /// Снимает резервную копию базы по требованию.
    /// </summary>
    /// <returns>Задача завершения.</returns>
    private async Task CreateBackupAsync()
    {
        _busy = true;
        _error = null;
        _message = null;

        var result = await Api.PostAsync<BackupResultDto>("api/v1/admin/backup", body: null);

        if (result.IsSuccess && result.Value is not null)
        {
            if (result.Value.Created)
            {
                _message = $"{result.Value.Message}: {result.Value.Path} ({FormatSize(result.Value.SizeBytes)})";

                // Сводку нужно перечитать: изменились и время последней копии,
                // и их число в каталоге, и свободное место.
                await LoadAsync();
            }
            else
            {
                _error = result.Value.Message;
            }
        }
        else
        {
            _error = result.Error;
        }

        _busy = false;
    }

    /// <summary>Переводит размер в удобные для чтения единицы.</summary>
    /// <param name="bytes">Размер в байтах.</param>
    /// <returns>Строка вида «5,9 ГБ».</returns>
    private static string FormatSize(long bytes)
    {
        string[] units = ["Б", "КБ", "МБ", "ГБ", "ТБ"];
        double value = bytes;
        var unit = 0;

        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }

        return $"{value:0.#} {units[unit]}";
    }

    /// <summary>
    /// Показывает момент времени или прочерк.
    /// </summary>
    /// <param name="moment">Момент времени в UTC.</param>
    /// <returns>Строка для показа.</returns>
    /// <remarks>
    /// Вид времени приходится проставлять вручную: сервер хранит время в UTC,
    /// но в JSON оно приходит без пометки, и без <c>SpecifyKind</c> перевод
    /// в местное время просто ничего не сделал бы.
    /// </remarks>
    private static string FormatMoment(DateTime? moment)
        => moment is null
            ? "не выполнялся"
            : DateTime.SpecifyKind(moment.Value, DateTimeKind.Utc).ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss");

    /// <summary>
    /// Показывает свободное место вместе с долей от общего объёма.
    /// </summary>
    /// <param name="free">Свободно, байт; <c>null</c> — определить не удалось.</param>
    /// <param name="total">Всего, байт; <c>null</c> — определить не удалось.</param>
    /// <returns>Строка вида «12,3 ГБ из 100 ГБ (12%)».</returns>
    private static string FormatSpace(long? free, long? total)
    {
        if (free is null || total is null || total.Value <= 0)
        {
            return "неизвестно";
        }

        var share = (int)(100.0 * free.Value / total.Value);
        return $"{FormatSize(free.Value)} из {FormatSize(total.Value)} ({share}%)";
    }
}
