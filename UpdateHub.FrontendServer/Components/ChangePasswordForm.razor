@inject AuthState Auth
@inject HttpClient Http

@*
    Смена пароля. Показывается в двух случаях: сразу после первого входа,
    когда сервер потребовал заменить временный пароль, и по желанию из панели.
*@

<div class="@(Required ? "stranica-vhoda" : string.Empty)">
    <div class="karta">
        <h2>Смена пароля</h2>

        @if (Required)
        {
            <div class="soobshchenie vnimanie">
                Пароль выдан при создании учётной записи и записан в журнале сервера.
                До его замены работа с панелью недоступна.
            </div>
        }

        @if (_error is not null)
        {
            <div class="soobshchenie oshibka">@_error</div>
        }

        @if (_done)
        {
            <div class="soobshchenie udacha">Пароль изменён.</div>
        }

        <EditForm Model="this" OnValidSubmit="SubmitAsync">
            <label>
                <span>Текущий пароль</span>
                <input type="password" @bind="_current" @bind:event="oninput" autocomplete="current-password" />
            </label>

            <label>
                <span>Новый пароль (не короче восьми символов)</span>
                <input type="password" @bind="_new" @bind:event="oninput" autocomplete="new-password" />
            </label>

            <label>
                <span>Новый пароль ещё раз</span>
                <input type="password" @bind="_confirmation" @bind:event="oninput" autocomplete="new-password" />
            </label>

            <button type="submit" disabled="@(_busy || !IsFilled)">
                @(_busy ? "Сохранение…" : "Сменить пароль")
            </button>
        </EditForm>
    </div>
</div>

@code {
    private string _current = string.Empty;
    private string _new = string.Empty;
    private string _confirmation = string.Empty;
    private string? _error;
    private bool _busy;
    private bool _done;

    /// <summary>Показывать ли форму как обязательный шаг после входа.</summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>Заполнены ли все поля.</summary>
    private bool IsFilled => _current.Length > 0 && _new.Length > 0 && _confirmation.Length > 0;

    /// <summary>
    /// Отправляет смену пароля.
    /// </summary>
    /// <returns>Задача завершения.</returns>
    /// <remarks>
    /// Совпадение с подтверждением проверяется здесь: серверу второе поле
    /// не отправляется вовсе, и отличить опечатку от намерения он не может.
    /// Длину пароля проверяет сервер — дублировать правило в двух местах
    /// значит однажды поменять его только в одном.
    /// <para>
    /// Обращение идёт напрямую, а не через <c>ApiClient</c>: тот при ответе 401
    /// обновляет токен и повторяет запрос, а здесь 401 означает неверный текущий
    /// пароль, и повторять нечего.
    /// </para>
    /// </remarks>
    private async Task SubmitAsync()
    {
        if (_new != _confirmation)
        {
            _error = "Пароли не совпадают";
            return;
        }

        _busy = true;
        _error = null;
        _done = false;

        var request = new HttpRequestMessage(HttpMethod.Post, "api/v1/auth/change-password")
        {
            Content = new FormUrlEncodedContent(new Dictionary<string, string>
            {
                ["current_password"] = _current,
                ["new_password"] = _new
            })
        };
        request.Headers.Authorization =
            new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Auth.AccessToken);

        try
        {
            var response = await Http.SendAsync(request);
            var text = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                _done = true;
                _current = _new = _confirmation = string.Empty;

                // Сервер отзывает выданные токены при смене пароля, поэтому
                // работать по старому access-токену дальше нельзя: нужен вход
                // с новым паролем.
                await Auth.LogoutAsync();
            }
            else
            {
                _error = TextProtocol.ExtractError(text, "Не удалось сменить пароль");
            }
        }
        catch (HttpRequestException)
        {
            _error = "Сервер недоступен";
        }

        _busy = false;
    }
}
