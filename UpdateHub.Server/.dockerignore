# Docker читает .dockerignore из корня контекста сборки, а контекст здесь —
# каталог UpdateHub.Server (см. Makefile: docker build выполняется отсюда).
# Файл в корне репозитория на эту сборку не влияет, поэтому нужен свой.
#
# Без него в контекст попадают bin и obj с машины разработчика. Внутри образа
# 'dotnet restore' затем натыкается на чужой obj/project.assets.json, собранный
# для другого пути и другого набора пакетов, и сборка падает с невнятным
# сообщением о недостающей цели.

**/bin
**/obj
**/.vs
**/.vscode
**/*.user
**/*.tar

# Каталог раздачи и база данных при запуске монтируются с хоста.
# Их содержимое в образе не нужно и может весить гигабайты.
files
data
