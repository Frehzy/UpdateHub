<Project>

  <!--
    Общие настройки всех проектов решения.

    Файл подхватывается автоматически всеми проектами ниже по дереву каталогов,
    поэтому версия платформы, режим ссылочных типов и неявные using задаются
    здесь в одном месте. Прежде они были переписаны в пяти файлах проектов,
    и переход на следующую версию .NET означал пять одинаковых правок, из
    которых одну обязательно забыли бы.

    Значение из файла проекта перекрывает заданное здесь: настройки этого
    файла подключаются раньше.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!--
      Предупреждения ошибками здесь не делаются намеренно: во время правки кода
      незаконченный фрагмент почти всегда их даёт, и падающая сборка в студии
      мешала бы работать. Ключ -warnaserror включён в сборке по коммитам —
      так в master ничего с новыми предупреждениями не попадёт.
    -->
  </PropertyGroup>

</Project>
