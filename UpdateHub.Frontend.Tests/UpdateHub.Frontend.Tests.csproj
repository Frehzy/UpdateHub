<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Тесты панели управления вынесены в отдельный проект, а не добавлены
    к UpdateHub.Backend.Tests, намеренно: ссылка на браузерное приложение тянет
    за собой пакеты Blazor WebAssembly, и неудача с ними не должна мешать
    прогону тестов сервера.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!--
      xunit.v3 работает поверх Microsoft.Testing.Platform. На .NET 10 команда
      `dotnet test` без этого свойства идёт прежним путём через VSTest, который
      платформа больше не поддерживает, и сборка падает ещё до запуска тестов.
      В Visual Studio это незаметно: она запускает тесты своим средством.
    -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <!--
      xUnit1051 требует передавать TestContext.Current.CancellationToken в каждый
      вызов, который принимает токен отмены. Смысл правила — чтобы прерванный
      тест переставал работать сразу. Здесь это не окупается: самый долгий тест
      идёт восемь секунд, общего ограничения по времени нет, а параметр пришлось
      бы дописать в двести строк, где он ничего не меняет.
    -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>

    <!--
      NU1902 — известная уязвимость средней важности в AngleSharp 1.3.0. Пакет
      приходит зависимостью bUnit и разбирает разметку, которую порождают наши
      же компоненты, внутри процесса проверок. На сервер он не попадает: проект
      тестов в образ не публикуется. Более новой версии bUnit, тянущей
      исправленный AngleSharp, на сегодня нет.
      Предупреждение снято точечно и по одному номеру, а не проверкой целиком:
      уязвимость в прямой зависимости обязана и дальше останавливать сборку.
      Как только bUnit обновит зависимость — эту строку убрать.
    -->
    <NoWarn>$(NoWarn);NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      bUnit поднимает компоненты Blazor в памяти и даёт разобрать полученную
      разметку. Без него панель проверялась только со стороны служб, а сама
      разметка — ничем: обращение к пустой ссылке в шаблоне даёт пустую
      страницу, и увидеть это можно было только глазами.
    -->
    <PackageReference Include="bunit" Version="2.0.66" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UpdateHub.FrontendServer\UpdateHub.FrontendServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
